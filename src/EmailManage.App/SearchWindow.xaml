<Window x:Class="EmailManage.SearchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MailZen — Conversational Outlook Search" Height="760" Width="1180" MinHeight="600" MinWidth="900" WindowStartupLocation="CenterScreen" Background="#F8FAFC">
  <Grid Margin="18">
    <Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.ColumnSpan="2" Background="#312E81" CornerRadius="10" Padding="18" Margin="0,0,0,14">
      <DockPanel><TextBlock Text="MailZen" Foreground="White" FontSize="24" FontWeight="Bold"/><TextBlock Text="  Conversational Outlook Search" Foreground="#DDD6FE" FontSize="16" VerticalAlignment="Center" Margin="12,0,0,0"/><TextBlock Text="{Binding AppVersion, StringFormat=Version {0}}" Foreground="#DDD6FE" FontSize="12" VerticalAlignment="Center" DockPanel.Dock="Right"/></DockPanel>
    </Border>
    <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,14,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="Search scope" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock Text="{Binding ScopeSummary}" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock Text="{Binding IndexSummary}" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock Text="Database location" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding DatabasePath}" Foreground="#475569" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,4"/>
        <Button Content="Open database folder" Command="{Binding OpenDatabaseLocationCommand}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Button Content="Select all" Command="{Binding SelectAllCommand}" Margin="0,0,6,0"/><Button Content="Clear" Command="{Binding ClearAllCommand}"/></StackPanel>
        <Grid Margin="0,0,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="Account" FontWeight="SemiBold" Foreground="#64748B"/><TextBlock Grid.Column="2" Text="Indexed range" FontWeight="SemiBold" Foreground="#64748B"/></Grid>
        <ItemsControl ItemsSource="{Binding Accounts}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,0,8,0"/><TextBlock Grid.Column="2" Text="{Binding CoverageText}" TextWrapping="Wrap" Foreground="#475569" FontSize="11" VerticalAlignment="Top"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <Separator Margin="0,14"/>
        <TextBlock Text="Mode" FontWeight="SemiBold"/>
        <ComboBox ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding SelectedModelId}" Margin="0,6,0,10"/>
        <TextBlock Text="Search mode" FontWeight="SemiBold"/>
        <ComboBox ItemsSource="{Binding SearchModeOptions}" SelectedItem="{Binding SelectedSearchMode}" Margin="0,6,0,6"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" ToolTip="{Binding Description}"/></DataTemplate></ComboBox.ItemTemplate><ComboBox.ToolTip>Hover over a mode for a quick explanation.</ComboBox.ToolTip></ComboBox>
        <TextBlock Text="Conversational AI and Boolean search are explicit modes; MailZen will not silently switch modes." TextWrapping="Wrap" Foreground="#475569" FontSize="11" Margin="0,0,0,12"/>
        <TextBlock Text="OpenAI API key" FontWeight="SemiBold"/>
        <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,6" ToolTip="Stored in Windows Credential Manager"/>
        <StackPanel Orientation="Horizontal"><Button Content="Save key" Command="{Binding SaveKeyCommand}" Margin="0,0,6,8"/><Button Content="Test AI connection" Command="{Binding TestAiCommand}" Margin="0,0,6,8" ToolTip="Checks the saved API key and selected model."/><Button Content="Remove" Command="{Binding RemoveKeyCommand}" Margin="0,0,0,8"/></StackPanel>
        <TextBlock Text="AI receives only selected candidates and short excerpts. Local search modes never send email content." TextWrapping="Wrap" Foreground="#475569" FontSize="11" Margin="0,0,0,12"/>
        <TextBlock Text="Manual index range" FontWeight="SemiBold" Margin="0,14,0,4"/>
        <TextBlock Text="Overlapping loads are safe; existing message IDs are updated instead of duplicated." TextWrapping="Wrap" Foreground="#475569" FontSize="11" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><DatePicker SelectedDate="{Binding IndexFromDate}" Width="102"/><TextBlock Text=" to " VerticalAlignment="Center"/><DatePicker SelectedDate="{Binding IndexToDate}" Width="102"/></StackPanel>
        <Button Content="Load date range" Command="{Binding SyncCommand}" Padding="10,6"/>
        <TextBlock Text="Automatic updates" FontWeight="SemiBold" Margin="0,14,0,4"/>
        <TextBlock Text="Daily sync resumes from the last successful checkpoint, so missed runs are caught up automatically. It runs without opening the search window." TextWrapping="Wrap" Foreground="#475569" FontSize="11" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,2"><TextBlock Text="Daily time" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox Text="{Binding DailySyncTime, UpdateSourceTrigger=PropertyChanged}" Width="72" ToolTip="Enter local time, for example 02:00 or 8:30 PM."/><TextBlock Text="(local time)" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel>
        <StackPanel Orientation="Horizontal"><Button Content="Schedule daily sync" Command="{Binding ScheduleSyncCommand}" Margin="0,0,6,8"/><Button Content="Remove" Command="{Binding RemoveScheduleCommand}" Margin="0,0,0,8"/></StackPanel>
        <Button Content="Sync new emails now" Command="{Binding SyncNewCommand}" Padding="10,6" HorizontalAlignment="Left" ToolTip="Syncs selected accounts from their last successful checkpoint, with a small overlap to catch newly arrived messages."/>
        <TextBlock Text="{Binding Status}" Foreground="#475569" TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel></ScrollViewer>
    </Border>
    <Grid Grid.Row="1" Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBox Grid.Row="0" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="17" Padding="12" MinHeight="48" ToolTip="Conversational AI: describe what you mean. Boolean mode: use parentheses, AND or &amp;, OR or |, and NOT."/>
      <StackPanel Grid.Row="1" Margin="0,10">
        <StackPanel Orientation="Horizontal"><Button Content="Search" Command="{Binding SearchCommand}" Padding="16,8" Background="#4F46E5" Foreground="White"/><ProgressBar IsIndeterminate="{Binding IsBusy}" Width="110" Height="12" Margin="12,0" VerticalAlignment="Center"/><TextBlock Text="{Binding ActivityStatus}" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#475569"/><TextBlock Text="{Binding ResultSummary}" VerticalAlignment="Center" Foreground="#475569"/></StackPanel>
        <DockPanel Margin="0,10,0,0"><TextBlock Text="Date range" FontWeight="SemiBold"/><TextBlock Text="{Binding DateRangeSummary}" DockPanel.Dock="Right" Foreground="#475569"/></DockPanel>
        <Grid Height="30" Margin="0,2,0,0">
          <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="18"/></Grid.RowDefinitions>
          <Slider Grid.Row="0" Minimum="{Binding DateRangeMinimum}" Maximum="{Binding DateRangeMaximum}" Value="{Binding SearchStartValue, Mode=TwoWay}" IsMoveToPointEnabled="True" ToolTip="Drag the start handle to change the beginning date."/>
          <Slider Grid.Row="1" Minimum="{Binding DateRangeMinimum}" Maximum="{Binding DateRangeMaximum}" Value="{Binding SearchEndValue, Mode=TwoWay}" IsMoveToPointEnabled="True" ToolTip="Drag the end handle to change the ending date."/>
        </Grid>
        <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SearchFromDate, StringFormat={}{0:MMM d, yyyy}}" Foreground="#475569"/><TextBlock Text="  to  " Foreground="#475569"/><TextBlock Text="{Binding SearchToDate, StringFormat={}{0:MMM d, yyyy}}" Foreground="#475569"/></StackPanel>
      </StackPanel>
      <ListView Grid.Row="2" ItemsSource="{Binding Results}"><ListView.ItemTemplate><DataTemplate><Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10"><StackPanel><DockPanel><TextBlock Text="{Binding Subject}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Received}" DockPanel.Dock="Right" Foreground="#64748B"/></DockPanel><TextBlock Text="{Binding Sender}" Foreground="#334155"/><TextBlock Text="{Binding Account}" Foreground="#64748B" FontSize="12"/><TextBlock Text="{Binding Excerpt}" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Foreground="#4338CA" FontStyle="Italic"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Open in Outlook" Command="{Binding DataContext.OpenResultCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,6,0"/><Button Content="Open .msg fallback" Command="{Binding DataContext.ExportResultCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></StackPanel></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView>
    </Grid>
  </Grid>
</Window>
