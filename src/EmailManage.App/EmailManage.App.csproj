<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>MailZen</AssemblyName>
    <RootNamespace>EmailManage</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- App metadata -->
    <Product>MailZen</Product>
    <Description>Conversational Outlook Classic search with a private local index</Description>
    <Company>MailZen</Company>
    <Copyright>Copyright © 2026</Copyright>
    <Version>2.0.10</Version>
    <FileVersion>2.0.10.0</FileVersion>
    <AssemblyVersion>2.0.10.0</AssemblyVersion>
    <ApplicationIcon>Resources\mailzen.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.8" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

</Project>
